{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ugoith/General_AI_Engineering_Architecture/schema/index.schema.json",
  "title": "AI 工程架构文件索引 (.ai/index/files.json)",
  "description": "由 `ai-arch index` 生成。hash 用于判定是否需要重读源码；digest 是语义摘要，由 AI 生成、CLI 校验。字段语义见 docs/system/04-context-discipline.md。",
  "type": "object",
  "required": ["schemaVersion", "generated", "fileCount", "files", "summary"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generated": { "type": "string", "description": "ISO 8601 时间戳" },
    "root": { "type": "string", "default": "." },
    "fileCount": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "description": "只包含文本文件与文本配置。非文本或超过 DEFAULT_INDEX_MAX_BYTES（cli/lib/limits.mjs）的文件被排除，不计入 fileCount，也不出现在任何任务读取清单里；排除数量记录在 excluded.count。资产/资源应由各类型的资产索引（如 UE 的 .ai/index/asset-index.md）描述。",
      "items": {
        "type": "object",
        "required": ["path", "kind", "lang", "hash", "digest"],
        "properties": {
          "path": { "type": "string", "description": "相对项目根的 POSIX 路径" },
          "kind": { "type": "string", "enum": ["text"], "description": "索引只收录文本文件；二进制与超大文件被排除" },
          "lang": { "type": "string" },
          "loc": { "type": ["integer", "null"], "description": "行数；二进制为 null" },
          "bytes": { "type": "integer" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "内容 SHA-256。hash 未变即无需重读源码" },
          "imports": { "type": "array", "items": { "type": "string" }, "description": "解析到的内部依赖（外部包不入内）" },
          "importedBy": { "type": "array", "items": { "type": "string" }, "description": "反向依赖，由 imports 计算" },
          "owner": { "type": ["string", "null"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "digest": {
            "type": "object",
            "required": ["status", "stale"],
            "properties": {
              "status": { "type": "string", "enum": ["pending", "digest", "stale", "skeleton"] },
              "purpose": { "type": ["string", "null"], "description": "≤ 200 字，说明为何存在、谁依赖它；不要复述代码" },
              "exports": { "type": "array", "items": { "type": "string" } },
              "invariants": { "type": "array", "items": { "type": "string" }, "description": "改这个文件时必须保持的约束" },
              "risk": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
              "tags": { "type": "array", "items": { "type": "string" } },
              "reviewedHash": { "type": ["string", "null"], "description": "该摘要对应的内容 hash；与 hash 不同即为 stale" },
              "reviewedAt": { "type": ["string", "null"] },
              "stale": { "type": "boolean" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "byRisk": {
          "type": "object",
          "properties": {
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" }
          }
        },
        "pendingDigest": { "type": "integer" },
        "staleDigest": { "type": "integer" },
        "totalLoc": { "type": "integer", "description": "源行数（不含 .ai/）：规模等级判定用这个" },
        "contextLoc": { "type": "integer", "description": ".ai/ 下参与判定的上下文文件行数；与 totalLoc 分开，避免上下文文档把项目"算大"一级" },
        "contextFiles": { "type": "integer", "description": ".ai/ 下参与判定的上下文文件个数" }
      }
    }
  }
}
